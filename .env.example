PORT=3000

# Conexion individual a PostgreSQL (desarrollo local / Docker):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_NAME=tasks_db

# Alternativa para la nube (Render, Neon, Supabase, Railway):
# Si se define DATABASE_URL, tiene prioridad sobre las variables DB_* individuales.
# DATABASE_URL=postgres://usuario:password@host:5432/tasks_db
# DB_SSL=true

# Minimo 32 caracteres, sin valor por defecto. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h

# 12 por defecto (minimo 10 fuera de pruebas)
BCRYPT_SALT_ROUNDS=12

# Rate limiting para /auth/* (15 minutos = 900000ms, maximo 10 peticiones)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
